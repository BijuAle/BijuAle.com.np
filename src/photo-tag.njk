---
layout: base.njk
pagination:
  data: photos.tags
  size: 1
  alias: tag
permalink: "/photo-tag/{{ tag | slugify }}/"
---

<a href="/pages/photo-memories/" class="back-btn">← Photo Memories</a>

<h1 class="tagName">{{ tag }}</h1>
<photo-gallery>
<div class="thumbs" id="thumbs-container">
  {% for photo in photos.byTag[tag] %} {% set thumb = photo.secure_url |
  replace('/upload/', '/upload/w_80,h_80,c_fill,q_70,f_webp,dpr_auto/') %}
  <img
    src="{{ thumb }}"
    alt="Thumbnail for {{ photo.alt or 'Photo' }}"
    class="thumb{% if loop.first %} active-thumb{% endif %}"
    data-index="{{ loop.index0 }}"
    data-medium="{{ photo.secure_url | replace('/upload/', '/upload/w_600,c_scale,q_75,f_webp,dpr_auto/') }}"
    data-large="{{ photo.secure_url | replace('/upload/', '/upload/w_1000,c_scale,q_80,f_webp,dpr_auto/') }}"
    data-xl="{{ photo.secure_url | replace('/upload/', '/upload/w_1400,c_scale,q_85,f_webp,dpr_auto/') }}"
    role="button"
    aria-label="View {{ photo.alt or 'photo' }}"
    tabindex="0"
  />
  {% endfor %}
</div>

<div class="container">
  <div class="photo-div" id="photo-container">
    <div class="photo-wrapper" style="position: relative; width: 100%;">
      <button class="nav-btn prev-btn" aria-label="Previous photo" id="prev-btn">
        <span class="arrow-icon">←</span>
      </button>
      <button class="nav-btn next-btn" aria-label="Next photo" id="next-btn">
        <span class="arrow-icon">→</span>
      </button>
      <div class="loading-indicator" id="loading-indicator">Loading...</div>

    {% for photo in photos.byTag[tag] %}
    <picture
      class="photo-picture{% if not loop.first %} hidden{% endif %}"
      data-index="{{ loop.index0 }}"
    >
      {% if loop.first %}
      <source
        media="(max-width: 600px)"
        srcset="{{ photo.secure_url | replace('/upload/', '/upload/w_600,c_scale,q_auto,f_webp,dpr_auto/') }}"
      />
      <source
        media="(max-width: 1200px)"
        srcset="{{ photo.secure_url | replace('/upload/', '/upload/w_1000,c_scale,q_auto,f_webp,dpr_auto/') }}"
      />
      <img
        src="{{ photo.secure_url | replace('/upload/', '/upload/w_1000,c_scale,q_auto,f_webp,dpr_auto/') }}"
        alt="{{ photo.alt or 'Photo' }}"
        class="photo-img loaded"
        loading="eager"
        fetchpriority="high"
      />
      {% else %}
      <img
        src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 600'%3E%3Crect width='800' height='600' fill='%23f0f0f0'/%3E%3C/svg%3E"
        alt="{{ photo.alt or 'Photo' }}"
        class="photo-img"
        loading="lazy"
      />
      {% endif %}
    </picture>
    {% endfor %}
    </div>
  </div>

  <div class="metadata-div" id="metadata-container">
    {% for photo in photos.byTag[tag] %}
    <div
      class="metadata-group{% if not loop.first %} hidden{% endif %}"
      data-index="{{ loop.index0 }}"
    >
      {% if photo.context and photo.context.caption %}
      <div class="caption">{{ photo.context.caption }}</div>
      {% endif %}

      <hr />

      <div class="metadata-list">
        {% if photo.context.DateTimeOriginal %}
        <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg> <em>{{ photo.context.DateTimeOriginal }}</em></span>
        {% endif %} {% if photo.context.Make %}
        <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path><circle cx="12" cy="13" r="4"></circle></svg> <em>{{ photo.context.Make }} {{ photo.context.Model }}</em></span>
        {% endif %} {% if photo.context.iso %}
        <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg> <em>ISO {{ photo.context.iso }}</em></span>
        {% endif %} {% if photo.context.ApertureValue %}
        <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="14.31" y1="8" x2="20.05" y2="17.94"></line><line x1="9.69" y1="8" x2="21.17" y2="8"></line><line x1="7.38" y1="12" x2="13.12" y2="2.06"></line><line x1="9.69" y1="16" x2="3.95" y2="6.06"></line><line x1="14.31" y1="16" x2="2.83" y2="16"></line><line x1="16.62" y1="12" x2="10.88" y2="21.94"></line></svg> <em>{{ photo.context.ApertureValue }}</em></span>
        {% endif %} {% if photo.context.FocalLength %}
        <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="22" y1="12" x2="18" y2="12"></line><line x1="6" y1="12" x2="2" y2="12"></line><line x1="12" y1="6" x2="12" y2="2"></line><line x1="12" y1="22" x2="12" y2="18"></line></svg> <em>{{ photo.context.FocalLength }}</em></span>
        {% endif %} {% if photo.context.ExposureTime %}
        <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> <em>{{ photo.context.ExposureTime }}</em></span>
        {% endif %} {% if photo.width %}
        <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg> <em>{{ photo.width }} × {{ photo.height }} px</em></span>
        {% endif %}
      </div>
      <div style="text-align:center; font-size: 0.8rem; margin-top: 1rem; opacity: 0.7;">© {% year %} Biju Ale</div>
      {% if photo.context.gps %}
      <div class="map-container">
        {% set gps = photo.context.gps | replace(' ', '') %} {% set lat =
        gps.split(',')[0] %} {% set lng = gps.split(',')[1] %}
        <iframe
          width="100%"
          height="320"
          frameborder="0"
          style="border: 0"
          referrerpolicy="no-referrer-when-downgrade"
          src="https://maps.google.com/maps?q={{ lat }},{{
            lng
          }}&z=15&t=k&output=embed"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</div>

<div id="kb-hint" style="text-align: center; font-size: 0.8rem; opacity: 0.6; margin-top: 5px; font-family: sans-serif; transition: opacity 0.5s;">
  <svg class="meta-icon" style="vertical-align: middle; margin-right: 4px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" ry="2"></rect><line x1="6" y1="8" x2="6" y2="8"></line><line x1="10" y1="8" x2="10" y2="8"></line><line x1="14" y1="8" x2="14" y2="8"></line><line x1="18" y1="8" x2="18" y2="8"></line><line x1="6" y1="12" x2="6" y2="12"></line><line x1="10" y1="12" x2="10" y2="12"></line><line x1="14" y1="12" x2="14" y2="12"></line><line x1="18" y1="12" x2="18" y2="12"></line><line x1="7" y1="16" x2="17" y2="16"></line></svg> Use arrow keys to navigate
</div>
</photo-gallery>

<style>
  .back-btn {
    display: inline-block;
    margin-bottom: 1rem;
    font-family: "Linux Biolinium O", sans-serif;
    font-size: 0.9rem;
    color: rgb(35, 63, 100);
    text-decoration: none;
    border: 1px solid rgba(35, 63, 100, 0.3);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: all 0.2s ease;
  }
  .back-btn:hover {
    background-color: rgb(35, 63, 100);
    color: white;
  }
  .tagName {
    text-align: center;
    margin: 0;
    padding: 0;
  }
  .container {
    display: flex;
    flex-wrap: nowrap;
    width: 100%;
    margin: 0 auto;
    padding: 10px;
    gap: 1%; /* 1% gap to nicely separate photo and metadata */
  }

  .photo-div {
    flex: 1;
    min-width: 0;
    border: 1px solid black;
    position: relative;
    background: transparent;
    display: flex;
    align-items: flex-start;
  }

  .metadata-div {
    flex: 0 0 25%; /* Prevents shrinking/growing, keeps it exactly 25% */
    max-width: 300px; /* Optional: keeps it from getting too wide on huge screens */
    padding: 10px;
    border: 1px solid black;
    overflow-y: auto;
  }

  .photo-picture {
    width: 100%;
    display: block;
    position: relative;
  }

  .photo-img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.2s ease;
  }

  .photo-img:not(.loaded) {
    filter: blur(2px);
    opacity: 0.7;
  }

  .photo-img.loaded {
    filter: none;
    opacity: 1;
  }

  .loading-indicator {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: rgba(0, 0, 0, 0.8);
    color: #75c6a1;
    padding: 10px 20px;
    border-radius: 4px;
    font-size: 14px;
    z-index: 5;
    display: none;
  }

  .loading-indicator.show {
    display: block;
  }

  .thumbs {
    margin: 0 auto;
    overflow-x: auto;
    border: 1px solid black;
    display: flex;
    gap: 4px;
    padding: 0 5px;
    scroll-behavior: smooth;
    /* Custom Scrollbar */
    scrollbar-width: thin;
    scrollbar-color: rgba(0,0,0,0.3) transparent;
  }
  .thumbs::-webkit-scrollbar {
    height: 6px;
  }
  .thumbs::-webkit-scrollbar-track {
    background: transparent;
  }
  .thumbs::-webkit-scrollbar-thumb {
    background-color: rgba(0,0,0,0.3);
    border-radius: 10px;
  }

  .thumbs img {
    margin: 0; /* Overrides inherited img margin from base.njk */
    display: block;
    cursor: pointer;
    -webkit-filter: grayscale(100%);
    filter: grayscale(100%);
    -webkit-transition: 0.2s ease-in-out;
    transition: 0.2s ease-in-out;
    border: 2px solid transparent;
    border-radius: 2px;
    flex-shrink: 0;
  }

  .thumbs img:hover,
  .thumbs img.active-thumb {
    -webkit-filter: grayscale(0);
    filter: grayscale(0);
    border-color: #007acc;
    transform: scale(1.05);
  }

  .photo-picture,
  .metadata-group {
    transition: opacity 0.3s ease-in-out;
    opacity: 1;
  }

  .photo-picture.hidden {
    opacity: 0;
    position: absolute;
    pointer-events: none;
    visibility: hidden;
  }

  .metadata-group.hidden {
    display: none;
  }

  .caption {
    text-align: center;
    font-size: clamp(1rem, 3vw, 1rem);
    font-family: "Linux Biolinium O";
    background: rgb(154, 154, 109);
    padding: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .nav-btn {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 15%;
    min-width: 60px;
    background: transparent;
    border: none;
    cursor: pointer;
    z-index: 10;
    transition: background 0.3s ease;
  }

  .prev-btn {
    left: 0;
  }

  .next-btn {
    right: 0;
  }

  .nav-btn:hover {
    background: rgba(0, 0, 0, 0.15); /* Subtle dark shade over half the photo */
  }

  .arrow-icon {
    position: absolute;
    top: 50%;
    color: white;
    font-size: 2rem;
    opacity: 0;
    transition: opacity 0.3s ease, transform 0.3s ease;
    text-shadow: 0 2px 6px rgba(0,0,0,0.6);
    pointer-events: none; /* Let the button handle clicks */
  }

  .prev-btn .arrow-icon {
    left: 20px;
    transform: translateY(-50%) translateX(-10px);
  }

  .next-btn .arrow-icon {
    right: 20px;
    transform: translateY(-50%) translateX(10px);
  }

  .prev-btn:hover .arrow-icon,
  .next-btn:hover .arrow-icon {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }


  .hidden {
    display: none !important;
  }
  .metadata-list {
    font-size: 0.85rem;
    font-family: "Linux Biolinium O", sans-serif;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.4rem;
  }
  .metadata-list span {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 0.3rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }
  .meta-icon {
    width: 14px;
    height: 14px;
    color: rgba(35, 63, 100, 0.7);
    flex-shrink: 0;
  }
  .metadata-list span em {
    font-style: normal;
    opacity: 0.8;
  }

  /* Mobile-friendly optimizations */
  @media (max-width: 600px) {
    .container {
      flex-direction: column;
    }

    .photo-div,
    .metadata-div {
      width: 100%;
      box-sizing: border-box;
    }

    .metadata-div {
      max-height: 50vh;
      max-width: none;
      margin: 0 auto;
    }

    .metadata-list{
      font-family: "Linux Biolinium O";
      list-style-type: none;
    }

    .metadata-list span {
      justify-content: center;
    }

    .thumbs {
      width: 100%;
      justify-content: flex-start;
    }
  }
</style>

<script>
  (function () {
    class FastPhotoGallery {
      constructor() {
        this.currentIndex = 0;
        this.isTransitioning = false;
        this.touchStartX = 0;
        this.touchEndX = 0;
        this.imageCache = new Map();
        
        // Use a unique name for the keydown listener to ensure we can remove it
        this.boundHandleKeydown = this.handleKeydown.bind(this);
        
        this.init();
      }

      init() {
        this.cacheElements();
        if (!this.thumbsContainer) return;
        this.setupEventListeners();
        this.preloadCriticalImages();
      }

      cacheElements() {
        this.thumbsContainer = document.getElementById("thumbs-container");
        this.photoContainer = document.getElementById("photo-container");
        this.metadataContainer = document.getElementById("metadata-container");
        this.prevBtn = document.getElementById("prev-btn");
        this.nextBtn = document.getElementById("next-btn");
        this.loadingIndicator = document.getElementById("loading-indicator");

        if (!this.thumbsContainer) return;

        this.thumbs = Array.from(this.thumbsContainer.querySelectorAll(".thumb"));
        this.photos = Array.from(this.photoContainer.querySelectorAll(".photo-picture"));
        this.metadataGroups = Array.from(this.metadataContainer.querySelectorAll(".metadata-group"));
        this.totalImages = this.thumbs.length;
      }

      setupEventListeners() {
        // Thumbnail clicks - Event delegation
        this.thumbsContainer.addEventListener("click", this.handleThumbnailClick.bind(this));
        this.thumbsContainer.addEventListener("keydown", this.handleThumbnailKeydown.bind(this));

        // Navigation buttons
        if (this.prevBtn) {
          this.prevBtn.addEventListener("click", () => this.navigateToIndex(this.getPrevIndex()));
        }
        if (this.nextBtn) {
          this.nextBtn.addEventListener("click", () => this.navigateToIndex(this.getNextIndex()));
        }

        // Global listeners - MUST be cleaned up
        document.addEventListener("keydown", this.boundHandleKeydown);

        // Touch for mobile
        if (this.photoContainer) {
          this.photoContainer.addEventListener("touchstart", this.handleTouchStart.bind(this), { passive: true });
          this.photoContainer.addEventListener("touchend", this.handleTouchEnd.bind(this), { passive: true });
          this.photoContainer.addEventListener("contextmenu", (e) => e.preventDefault());
        }
      }

      cleanup() {
        // Remove global listeners that persist across Turbo page swaps
        document.removeEventListener("keydown", this.boundHandleKeydown);
        
        // Clear references
        this.thumbs = [];
        this.photos = [];
        this.metadataGroups = [];
      }

      async preloadCriticalImages() {
        const criticalIndices = [0, 1, 2].filter((i) => i < this.totalImages);
        for (const index of criticalIndices) {
          await this.loadImageForIndex(index, index === 0);
        }
      }

      async loadImageForIndex(index, isUrgent = false) {
        if (index < 0 || index >= this.totalImages) return;
        const thumb = this.thumbs[index];
        const picture = this.photos[index];
        if (!picture) return;
        const img = picture.querySelector(".photo-img");

        if (img.classList.contains("loaded") || img.dataset.loading) return;
        img.dataset.loading = "true";
        if (isUrgent) this.showLoading();

        try {
          const screenWidth = window.innerWidth;
          let imageUrl = screenWidth <= 600 ? thumb.dataset.medium : (screenWidth <= 1200 ? thumb.dataset.large : thumb.dataset.xl);

          const tempImg = new Image();
          await new Promise((resolve, reject) => {
            tempImg.onload = () => {
              if (picture.querySelectorAll("source").length === 0) {
                const s1 = document.createElement("source"); s1.media = "(max-width: 600px)"; s1.srcset = thumb.dataset.medium;
                const s2 = document.createElement("source"); s2.media = "(max-width: 1200px)"; s2.srcset = thumb.dataset.large;
                picture.insertBefore(s1, img);
                picture.insertBefore(s2, img);
              }
              img.src = imageUrl;
              img.classList.add("loaded");
              delete img.dataset.loading;
              this.imageCache.set(index, imageUrl);
              resolve();
            };
            tempImg.onerror = reject;
            setTimeout(() => reject(new Error("Timeout")), 10000);
            tempImg.src = imageUrl;
          });
        } catch (e) {
          console.warn("Load failed", e);
        } finally {
          if (isUrgent) this.hideLoading();
        }
      }

      showLoading() { if (this.loadingIndicator) this.loadingIndicator.classList.add("show"); }
      hideLoading() { if (this.loadingIndicator) this.loadingIndicator.classList.remove("show"); }

      async navigateToIndex(newIndex) {
        if (this.isTransitioning || newIndex === this.currentIndex || newIndex < 0 || newIndex >= this.totalImages) return;

        this.isTransitioning = true;
        const oldIndex = this.currentIndex;
        this.currentIndex = newIndex;

        await this.loadImageForIndex(newIndex, true);
        
        const kbHint = document.getElementById('kb-hint');
        if (kbHint) kbHint.style.opacity = '0';

        this.updateUI(oldIndex, newIndex);
        this.preloadAdjacentImages(newIndex);

        setTimeout(() => { this.isTransitioning = false; }, 200);
      }

      updateUI(oldIndex, newIndex) {
        [this.photos, this.metadataGroups].forEach(list => {
          if (list[oldIndex]) list[oldIndex].classList.add("hidden");
          if (list[newIndex]) list[newIndex].classList.remove("hidden");
        });

        if (this.thumbs[oldIndex]) this.thumbs[oldIndex].classList.remove("active-thumb");
        if (this.thumbs[newIndex]) {
          this.thumbs[newIndex].classList.add("active-thumb");
          this.thumbs[newIndex].scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" });
        }
      }

      preloadAdjacentImages(index) {
        const indices = [this.getPrevIndex(index), this.getNextIndex(index)];
        indices.forEach(i => {
          if ("requestIdleCallback" in window) requestIdleCallback(() => this.loadImageForIndex(i));
          else setTimeout(() => this.loadImageForIndex(i), 100);
        });
      }

      handleThumbnailClick(e) {
        const thumb = e.target.closest(".thumb");
        if (thumb) this.navigateToIndex(parseInt(thumb.dataset.index));
      }

      handleThumbnailKeydown(e) {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          this.handleThumbnailClick(e);
        }
      }

      handleKeydown(e) {
        if (e.target.tagName === "INPUT" || e.target.tagName === "TEXTAREA") return;
        switch (e.key) {
          case "ArrowLeft": e.preventDefault(); this.navigateToIndex(this.getPrevIndex()); break;
          case "ArrowRight": e.preventDefault(); this.navigateToIndex(this.getNextIndex()); break;
          case "Home": e.preventDefault(); this.navigateToIndex(0); break;
          case "End": e.preventDefault(); this.navigateToIndex(this.totalImages - 1); break;
          case "Escape": if (window.history.length > 1) window.history.back(); break;
        }
      }

      handleTouchStart(e) { this.touchStartX = e.changedTouches[0].screenX; }
      handleTouchEnd(e) { 
        this.touchEndX = e.changedTouches[0].screenX;
        const diff = this.touchStartX - this.touchEndX;
        if (Math.abs(diff) > 50) this.navigateToIndex(diff > 0 ? this.getNextIndex() : this.getPrevIndex());
      }

      getPrevIndex(index = this.currentIndex) { return index > 0 ? index - 1 : this.totalImages - 1; }
      getNextIndex(index = this.currentIndex) { return index < this.totalImages - 1 ? index + 1 : 0; }
    }

    class PhotoGalleryElement extends HTMLElement {
      connectedCallback() {
        // Run after a tiny delay to ensure children are parsed
        setTimeout(() => {
          this.gallery = new FastPhotoGallery();
          
          // Close mobile menu if open
          const checkbox = document.getElementById("check-menu");
          if (checkbox) checkbox.checked = false;
        }, 10);
      }
      
      disconnectedCallback() {
        if (this.gallery) {
          this.gallery.cleanup();
          this.gallery = null;
        }
      }
    }
    
    if (!customElements.get('photo-gallery')) {
      customElements.define('photo-gallery', PhotoGalleryElement);
    }
  })();
</script>
