---
layout: base.njk
title: Essays
pagination:
  size: 20
  data: collections.post
  alias: posts
  reverse: true
---

<div class="index-layout">
  <div class="post-list-column">
    {%- for post in pagination.items %}
    <div class="listing-item">
      <span class="listing-date">{{ post.date | formatted }}</span>
      <a class="listing-title" href="{{ post.url }}">{{ post.data.title }}</a>
    </div>
    {%- endfor %}

    <div style="margin-top: 2rem; text-align: center; font-size: 1.5rem; opacity: 0.8;">
      {% if pagination.href.previous %}<a href="{{ pagination.href.previous }}">☜</a>{% endif %}
      {% if pagination.href.next %}<a href="{{ pagination.href.next }}">☞</a>{% endif %}
    </div>
  </div>

  <aside class="category-sidebar">
    <h2>Category</h2>
    <div class="category-list">
      {%- for tag in collections | getAllTags | sort %}
      {%- if tag != "post" %}
      <a href="/tags/{{ tag | slugify }}/">
        {{ tag }} ({{ collections[tag].length }})
      </a>
      {%- endif %}
      {%- endfor %}
    </div>
  </aside>
</div>