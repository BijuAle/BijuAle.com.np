---
layout: base.njk
pagination:
  data: photos.tags
  size: 1
  alias: tag
permalink: "/photo-tag/{{ tag | slugify }}/"
---

<h1>{{ tag }}</h1>

<div class="slideshow-wrapper">
    {% set tagPhotos = photos.byTag[tag] %}
    
    {% if tagPhotos | length > 1 %}
    <div class="slideshow-top-nav">
        <button class="nav-btn" onclick="moveSlide(-1)" aria-label="Previous image">&#10094;</button>
        <span class="slide-counter"><span id="current-slide-num">1</span> / {{ tagPhotos | length }}</span>
        <button class="nav-btn" onclick="moveSlide(1)" aria-label="Next image">&#10095;</button>
    </div>
    {% endif %}

    <div id="slideshow-container">
        {% for photo in tagPhotos %}
        <div class="slide {% if loop.first %}active{% endif %}">
            <div class="slide-image-container">
                <img src="{{ photo.secure_url }}" alt="{{ photo.alt }}" onclick="toggleFullscreen()" title="Click to view fullscreen" {% if not loop.first %}loading="lazy"{% endif %}>
            </div>

            <div class="slide-sidebar">
                <div class="metadata-list">
                    {% if photo.context.DateTimeOriginal %}
                    <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg> <em>{{ photo.context.DateTimeOriginal }}</em></span>
                    {% endif %} {% if photo.context.Make %}
                    <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z">
                            </path>
                            <circle cx="12" cy="13" r="4"></circle>
                        </svg> <em>{{ photo.context.Make }} {{ photo.context.Model }}</em></span>
                    {% endif %} {% if photo.context.iso %}
                    <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                            <line x1="7" y1="2" x2="7" y2="22"></line>
                            <line x1="17" y1="2" x2="17" y2="22"></line>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <line x1="2" y1="7" x2="7" y2="7"></line>
                            <line x1="2" y1="17" x2="7" y2="17"></line>
                            <line x1="17" y1="17" x2="22" y2="17"></line>
                            <line x1="17" y1="7" x2="22" y2="7"></line>
                        </svg> <em>ISO {{ photo.context.iso }}</em></span>
                    {% endif %} {% if photo.context.ApertureValue %}
                    <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="14.31" y1="8" x2="20.05" y2="17.94"></line>
                            <line x1="9.69" y1="8" x2="21.17" y2="8"></line>
                            <line x1="7.38" y1="12" x2="13.12" y2="2.06"></line>
                            <line x1="9.69" y1="16" x2="3.95" y2="6.06"></line>
                            <line x1="14.31" y1="16" x2="2.83" y2="16"></line>
                            <line x1="16.62" y1="12" x2="10.88" y2="21.94"></line>
                        </svg> <em>{{ photo.context.ApertureValue }}</em></span>
                    {% endif %} {% if photo.context.FocalLength %}
                    <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="22" y1="12" x2="18" y2="12"></line>
                            <line x1="6" y1="12" x2="2" y2="12"></line>
                            <line x1="12" y1="6" x2="12" y2="2"></line>
                            <line x1="12" y1="22" x2="12" y2="18"></line>
                        </svg> <em>{{ photo.context.FocalLength }}</em></span>
                    {% endif %} {% if photo.context.ExposureTime %}
                    <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <polyline points="12 6 12 12 16 14"></polyline>
                        </svg> <em>{{ photo.context.ExposureTime }}</em></span>
                    {% endif %} {% if photo.width %}
                    <span><svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path
                                d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3">
                            </path>
                        </svg> <em>{{ photo.width }} × {{ photo.height }} px</em></span>
                    {% endif %}
                </div>


                {% if photo.context.gps %}
                <div class="map-container">
                    {% set gps = photo.context.gps | replace(' ', '') %}
                    {% set lat = gps.split(',')[0] %}
                    {% set lng = gps.split(',')[1] %}
                    <iframe width="100%" height="320" frameborder="0" style="border: 0"
                        referrerpolicy="no-referrer-when-downgrade"
                        src="https://maps.google.com/maps?q={{ lat }},{{ lng }}&z=15&t=k&output=embed" allowfullscreen
                        loading="lazy"></iframe>
                </div>
                {% endif %}
            </div>
        </div>
        {% endfor %}
    </div>
</div>

<script>
    // Using window to avoid 'Identifier has already been declared' errors 
    // when Turbo Drive re-evaluates the script on subsequent page visits.
    window.currentSlide = 0;

    window.moveSlide = function(n) {
        const slides = document.querySelectorAll('.slide');
        if (slides.length === 0) return;

        slides[window.currentSlide].classList.remove('active');

        window.currentSlide += n;

        if (window.currentSlide >= slides.length) {
            window.currentSlide = 0;
        } else if (window.currentSlide < 0) {
            window.currentSlide = slides.length - 1;
        }

        slides[window.currentSlide].classList.add('active');
        
        const counter = document.getElementById('current-slide-num');
        if (counter) {
            counter.innerText = window.currentSlide + 1;
        }
    }

    window.toggleFullscreen = function() {
        const img = document.querySelector('.slide.active .slide-image-container img');
        if (!img) return;
        
        if (!document.fullscreenElement) {
            img.requestFullscreen().catch(err => {
                console.log(`Error attempting to enable fullscreen: ${err.message}`);
            });
        } else {
            document.exitFullscreen();
        }
    }

    // Touch swipe gestures
    if (!window.swipeInitialized) {
        let touchstartX = 0;
        let touchendX = 0;

        document.addEventListener('touchstart', e => {
            touchstartX = e.changedTouches[0].screenX;
        }, {passive: true});

        document.addEventListener('touchend', e => {
            touchendX = e.changedTouches[0].screenX;
            if (document.querySelector('.slideshow-wrapper')) {
                const swipeThreshold = 50;
                if (touchendX < touchstartX - swipeThreshold) window.moveSlide(1);
                if (touchendX > touchstartX + swipeThreshold) window.moveSlide(-1);
            }
        }, {passive: true});

        window.swipeInitialized = true;
    }
</script>
<style>
    .slideshow-wrapper {
        margin: 2rem 0;
        position: relative;
    }

    .slide {
        display: none;
        animation: fadeEffect 0.6s ease-in-out;
    }

    .slide.active {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    @media (min-width: 700px) {
        .slide.active {
            flex-direction: row;
            align-items: flex-start;
        }
    }

    .slide-image-container {
        flex: 1;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        border-radius: 4px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        background: rgba(0, 0, 0, 0.03);
    }

    .slide-image-container img {
        max-width: 100%;
        max-height: 70vh;
        object-fit: contain;
        display: block;
        border-radius: 2px;
        /* Film-like border */
        border: 20px solid #111;
        background-color: #000;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
        cursor: pointer;
        transition: transform 0.2s ease;
    }

    .slide-image-container img:hover {
        transform: scale(1.02);
    }

    .slide-sidebar {
        width: 100%;
        font-family: "Garamond", serif;
    }

    @media (min-width: 700px) {
        .slide-sidebar {
            width: 250px;
            flex-shrink: 0;
        }
    }

    .metadata-list {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
        padding: 1.5rem;
        background: rgba(255, 255, 255, 0.2);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 4px;
    }

    .metadata-list span {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-size: 1rem;
        color: var(--text-main);
    }

    .meta-icon {
        width: 18px;
        height: 18px;
        color: var(--accent-ink);
        opacity: 0.8;
    }

    .metadata-list em {
        font-style: normal;
        font-family: inherit;
        font-size: 0.95rem;
    }

    .map-container {
        margin-top: 1.5rem;
        border-radius: 4px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .slideshow-top-nav {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 1.5rem;
        margin-bottom: 2rem;
        font-family: "AireRomanPro", Garamond, serif;
    }
    
    .slide-counter {
        font-size: 1.4rem;
        color: var(--text-heading);
        min-width: 5rem;
        text-align: center;
        letter-spacing: 2px;
    }

    .nav-btn {
        background: rgba(255, 255, 255, 0.4);
        border: 1px solid rgba(0, 0, 0, 0.1);
        color: var(--text-main);
        width: 40px;
        height: 40px;
        border-radius: 50%;
        font-size: 1.2rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .nav-btn:hover {
        background: rgba(255, 255, 255, 0.8);
        transform: scale(1.05);
    }

    @keyframes fadeEffect {
        from {
            opacity: 0.3;
        }

        to {
            opacity: 1;
        }
    }
</style>