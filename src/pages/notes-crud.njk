---
layout: base.njk
title: "Notes CRUD"
description: "View, filter, search, and manage your Kindle clippings and highlights."
permalink: /pages/notes-crud/
---

<div class="notes-container">
  <!-- Top Action Bar -->
  <div class="notes-action-bar">
    <div class="search-box">
      <span class="search-icon">🔍</span>
      <input type="text" id="notes-search-input" placeholder="Search highlights, notes, or books..." aria-label="Search notes" />
      <button id="clear-search-btn" class="btn btn-text" style="display: none;">clear</button>
    </div>
    
    <button id="add-note-btn" class="btn btn-primary" disabled>
      <span class="btn-icon">✚</span> Add Clipping
    </button>
  </div>

  <!-- Server Status Banner -->
  <div id="api-status-banner" class="status-banner info">
    <span class="status-icon">ℹ</span>
    <span class="status-text">Connecting to Kindle Local API...</span>
  </div>

  <div class="notes-layout">
    <!-- Books Sidebar Selector -->
    <aside class="books-sidebar" aria-label="Books selection">
      <div class="sidebar-header">
        <h3>Books</h3>
        <span class="books-count-badge" id="books-count">0</span>
      </div>
      <div class="sidebar-search">
        <input type="text" id="sidebar-books-search" placeholder="Filter books..." aria-label="Filter books list" />
      </div>
      <ul class="books-list" id="books-list-el">
        <!-- Rendered dynamically -->
      </ul>
    </aside>

    <!-- Main Content Area -->
    <section class="notes-grid-section" aria-label="Clippings list">
      <div class="grid-header">
        <h2 id="current-filter-title">All Clippings</h2>
        <span class="notes-count-badge" id="notes-count">0</span>
      </div>
      
      <div class="notes-grid" id="notes-grid-el">
        <!-- Rendered dynamically -->
      </div>

      <div class="empty-state" id="empty-state-el" style="display: none;">
        <div class="empty-icon">📖</div>
        <h3>No clippings found</h3>
        <p>Try resetting filters or searching for something else.</p>
        <button id="reset-filters-btn" class="btn btn-secondary">Reset Filters</button>
      </div>
    </section>
  </div>
</div>

<!-- Modal Backdrop -->
<div class="modal-backdrop" id="note-modal-backdrop"></div>

<!-- Create / Edit Note Modal -->
<div class="modal" id="note-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
  <div class="modal-header">
    <h3 id="modal-title">Add New Clipping</h3>
    <button class="modal-close" id="close-modal-btn" aria-label="Close dialog">×</button>
  </div>
  <form id="note-form" class="modal-form">
    <div class="form-group">
      <label for="form-title">Book Title <span class="required">*</span></label>
      <input type="text" id="form-title" required placeholder="e.g., The Case for Miracles" list="autocomplete-books" />
      <datalist id="autocomplete-books">
        <!-- Auto populated -->
      </datalist>
    </div>
    
    <div class="form-group">
      <label for="form-author">Author <span class="required">*</span></label>
      <input type="text" id="form-author" required placeholder="e.g., Lee Strobel" />
    </div>

    <div class="form-row">
      <div class="form-group col">
        <label for="form-type">Type</label>
        <select id="form-type">
          <option value="Highlight">Highlight</option>
          <option value="Note">Note</option>
          <option value="Bookmark">Bookmark</option>
        </select>
      </div>
      <div class="form-group col">
        <label for="form-page">Page</label>
        <input type="text" id="form-page" placeholder="e.g., 26 or 12-14" />
      </div>
      <div class="form-group col">
        <label for="form-location">Location</label>
        <input type="text" id="form-location" placeholder="e.g., 394-396" />
      </div>
    </div>

    <div class="form-group">
      <label for="form-content">Clipping Text / Content</label>
      <textarea id="form-content" rows="6" placeholder="Paste or type the text snippet here..."></textarea>
    </div>

    <div class="modal-footer">
      <button type="button" id="cancel-modal-btn" class="btn btn-secondary">Cancel</button>
      <button type="submit" class="btn btn-primary">Save Changes</button>
    </div>
  </form>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal" id="delete-modal" role="dialog" aria-modal="true" aria-labelledby="delete-modal-title">
  <div class="modal-header">
    <h3 id="delete-modal-title">Delete Clipping</h3>
    <button class="modal-close" id="close-delete-modal-btn" aria-label="Close dialog">×</button>
  </div>
  <div class="modal-body">
    <p>Are you sure you want to permanently delete this clipping? This action will edit your copied clippings text file on disk and cannot be undone.</p>
    <div class="delete-preview-box">
      <strong id="delete-preview-book"></strong>
      <blockquote id="delete-preview-text"></blockquote>
    </div>
  </div>
  <div class="modal-footer">
    <button type="button" id="cancel-delete-modal-btn" class="btn btn-secondary">Cancel</button>
    <button type="button" id="confirm-delete-btn" class="btn btn-danger">Delete</button>
  </div>
</div>

