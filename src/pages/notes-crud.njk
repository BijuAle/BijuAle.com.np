<!-- JSON global state script -->
<script>
  // Statically generated notes loaded at build time
  const staticNotes = {{ clippings | dump | safe }} || [];
</script>

<!-- AJAX Client-Side CRUD Controller -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    let notes = [...staticNotes];
    let selectedBook = "all";
    let searchQuery = "";
    let isApiConnected = false;
    let noteToEdit = null;
    let noteToDelete = null;

    // DOM Elements
    const gridEl = document.getElementById("notes-grid-el");
    const booksListEl = document.getElementById("books-list-el");
    const currentFilterTitleEl = document.getElementById("current-filter-title");
    const notesCountEl = document.getElementById("notes-count");
    const booksCountEl = document.getElementById("books-count");
    const searchInput = document.getElementById("notes-search-input");
    const clearSearchBtn = document.getElementById("clear-search-btn");
    const booksSearchInput = document.getElementById("sidebar-books-search");
    const addNoteBtn = document.getElementById("add-note-btn");
    const apiStatusBanner = document.getElementById("api-status-banner");
    const emptyStateEl = document.getElementById("empty-state-el");
    const resetFiltersBtn = document.getElementById("reset-filters-btn");
    
    // Modal Elements
    const noteModal = document.getElementById("note-modal");
    const noteModalBackdrop = document.getElementById("note-modal-backdrop");
    const modalTitleEl = document.getElementById("modal-title");
    const noteForm = document.getElementById("note-form");
    const autocompleteDatalist = document.getElementById("autocomplete-books");
    
    // Form Inputs
    const formTitle = document.getElementById("form-title");
    const formAuthor = document.getElementById("form-author");
    const formType = document.getElementById("form-type");
    const formPage = document.getElementById("form-page");
    const formLocation = document.getElementById("form-location");
    const formContent = document.getElementById("form-content");
    
    // Delete Modal Elements
    const deleteModal = document.getElementById("delete-modal");
    const deletePreviewBook = document.getElementById("delete-preview-book");
    const deletePreviewText = document.getElementById("delete-preview-text");
    const confirmDeleteBtn = document.getElementById("confirm-delete-btn");

    // Close Modal triggers
    const closeModalElements = [
      document.getElementById("close-modal-btn"),
      document.getElementById("cancel-modal-btn"),
      document.getElementById("close-delete-modal-btn"),
      document.getElementById("cancel-delete-modal-btn"),
      noteModalBackdrop
    ];

    // Initialize Check for Local Dev Server API
    async function checkApiConnection() {
      try {
        const response = await fetch("/api/notes");
        if (response.ok) {
          const freshNotes = await response.json();
          notes = freshNotes;
          isApiConnected = true;
          
          apiStatusBanner.className = "status-banner success";
          apiStatusBanner.innerHTML = `<span class="status-icon">✓</span> <span class="status-text">Connected to Kindle Local API. CRUD edits will reflect on file.</span>`;
          addNoteBtn.removeAttribute("disabled");
        } else {
          setReadOnlyMode("Server error fetching fresh notes");
        }
      } catch (err) {
        setReadOnlyMode("API offline (static mode)");
      }
      
      renderSidebar();
      renderGrid();
    }

    function setReadOnlyMode(reason) {
      isApiConnected = false;
      apiStatusBanner.className = "status-banner warning";
      apiStatusBanner.innerHTML = `<span class="status-icon">⚠</span> <span class="status-text">Read-Only Mode: ${reason}. CRUD edits disabled.</span>`;
      addNoteBtn.setAttribute("disabled", "true");
    }

    // Modal Handlers
    function showModal(editMode = false) {
      noteModalBackdrop.classList.add("active");
      noteModal.classList.add("active");
      
      // Auto-fill author if book selected
      if (!editMode && selectedBook !== "all") {
        const matchingNote = notes.find(n => n.title === selectedBook);
        if (matchingNote) {
          formTitle.value = matchingNote.title;
          formAuthor.value = matchingNote.author;
        }
      }
      
      // Populate datalist for auto-complete
      const uniqueBooks = Array.from(new Set(notes.map(n => n.title)));
      autocompleteDatalist.innerHTML = uniqueBooks.map(b => `<option value="${b}"></option>`).join("");
    }

    function hideModals() {
      noteModalBackdrop.classList.remove("active");
      noteModal.classList.remove("active");
      deleteModal.classList.remove("active");
      
      // Reset form
      noteForm.reset();
      noteToEdit = null;
      noteToDelete = null;
    }

    closeModalElements.forEach(el => el.addEventListener("click", hideModals));

    // Handle book autocomplete select (auto fill author)
    formTitle.addEventListener("input", (e) => {
      const match = notes.find(n => n.title.toLowerCase() === e.target.value.toLowerCase());
      if (match) {
        formAuthor.value = match.author;
      }
    });

    // Save Note Form Submission
    noteForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!isApiConnected) return;

      const payload = {
        title: formTitle.value.trim(),
        author: formAuthor.value.trim(),
        type: formType.value,
        page: formPage.value.trim(),
        location: formLocation.value.trim(),
        content: formContent.value.trim()
      };

      try {
        let response;
        if (noteToEdit) {
          // Update
          response = await fetch("/api/notes/update", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              original: noteToEdit,
              updated: payload
            })
          });
        } else {
          // Create
          response = await fetch("/api/notes/create", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
        }

        if (response.ok) {
          hideModals();
          // Reload fresh notes list from server
          const getRes = await fetch("/api/notes");
          if (getRes.ok) {
            notes = await getRes.json();
            renderSidebar();
            renderGrid();
          }
        } else {
          alert("Error saving note: " + (await response.text()));
        }
      } catch (err) {
        alert("API connection failed. Could not save clipping.");
      }
    });

    // Confirm Delete Click
    confirmDeleteBtn.addEventListener("click", async () => {
      if (!noteToDelete || !isApiConnected) return;

      try {
        const response = await fetch("/api/notes/delete", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ note: noteToDelete })
        });

        if (response.ok) {
          hideModals();
          // Reload
          const getRes = await fetch("/api/notes");
          if (getRes.ok) {
            notes = await getRes.json();
            // If the deleted note was the last note of the selected book, reset book filter to "all"
            if (selectedBook !== "all" && !notes.some(n => n.title === selectedBook)) {
              selectedBook = "all";
            }
            renderSidebar();
            renderGrid();
          }
        } else {
          alert("Error deleting clipping: " + (await response.text()));
        }
      } catch (err) {
        alert("API connection failed. Could not delete clipping.");
      }
    });

    // Add Note Trigger
    addNoteBtn.addEventListener("click", () => {
      modalTitleEl.textContent = "Add New Clipping";
      noteToEdit = null;
      showModal(false);
    });

    // Render Books Sidebar
    function renderSidebar() {
      // Get counts of notes per book
      const bookCounts = {};
      const bookAuthors = {};
      
      notes.forEach(note => {
        bookCounts[note.title] = (bookCounts[note.title] || 0) + 1;
        if (!bookAuthors[note.title]) {
          bookAuthors[note.title] = note.author;
        }
      });

      const uniqueBooks = Object.keys(bookCounts).sort((a, b) => a.localeCompare(b));
      booksCountEl.textContent = uniqueBooks.length;
      
      // Filter list of books by sidebar search query
      const bookFilterQuery = booksSearchInput.value.toLowerCase().trim();
      const filteredBooks = uniqueBooks.filter(book => 
        book.toLowerCase().includes(bookFilterQuery) ||
        (bookAuthors[book] && bookAuthors[book].toLowerCase().includes(bookFilterQuery))
      );

      // Clear & rebuild
      booksListEl.innerHTML = "";

      // Add "All Books" item
      const allLi = document.createElement("li");
      allLi.className = selectedBook === "all" ? "active" : "";
      allLi.innerHTML = `
        <div class="book-item-info">
          <span class="book-item-title">All Books</span>
          <span class="book-item-author">View everything</span>
        </div>
        <span class="books-count-badge">${notes.length}</span>
      `;
      allLi.addEventListener("click", () => {
        selectedBook = "all";
        renderSidebar();
        renderGrid();
      });
      booksListEl.appendChild(allLi);

      // Add each book item
      filteredBooks.forEach(book => {
        const li = document.createElement("li");
        li.className = selectedBook === book ? "active" : "";
        li.innerHTML = `
          <div class="book-item-info">
            <span class="book-item-title" title="${book}">${book}</span>
            <span class="book-item-author" title="${bookAuthors[book]}">${bookAuthors[book]}</span>
          </div>
          <span class="books-count-badge">${bookCounts[book]}</span>
        `;
        li.addEventListener("click", () => {
          selectedBook = book;
          renderSidebar();
          renderGrid();
        });
        booksListEl.appendChild(li);
      });
    }

    // Render Grid of Cards
    function renderGrid() {
      // Filter notes
      let filteredNotes = notes;

      // 1. Filter by book selection
      if (selectedBook !== "all") {
        filteredNotes = notes.filter(n => n.title === selectedBook);
        currentFilterTitleEl.textContent = selectedBook;
      } else {
        currentFilterTitleEl.textContent = "All Clippings";
      }

      // 2. Filter by search query
      if (searchQuery) {
        filteredNotes = filteredNotes.filter(n => 
          n.content.toLowerCase().includes(searchQuery) ||
          n.title.toLowerCase().includes(searchQuery) ||
          n.author.toLowerCase().includes(searchQuery)
        );
      }

      // Update count
      notesCountEl.textContent = filteredNotes.length;

      // Reset DOM grid
      gridEl.innerHTML = "";

      if (filteredNotes.length === 0) {
        emptyStateEl.style.display = "block";
        gridEl.style.display = "none";
        return;
      } else {
        emptyStateEl.style.display = "none";
        gridEl.style.display = "grid";
      }

      // Render cards
      filteredNotes.forEach(note => {
        const card = document.createElement("div");
        card.className = "note-card";
        
        const isBookmark = note.type === "Bookmark";
        const hasContent = note.content && note.content.trim().length > 0;
        
        let metadataString = "";
        if (note.page) metadataString += `Page ${note.page}`;
        if (note.location) {
          if (metadataString) metadataString += ` • `;
          metadataString += `Loc ${note.location}`;
        }
        if (!metadataString) metadataString = "Snippet";

        const badgeClass = note.type.toLowerCase();
        
        // Title block visibility: visible if viewing "All Books"
        const showTitleBlock = selectedBook === "all" ? "visible" : "";

        card.innerHTML = `
          <div class="card-top">
            <span>🔖 ${metadataString}</span>
            <span class="card-badge ${badgeClass}">${note.type}</span>
          </div>
          
          <div class="card-title-author ${showTitleBlock}">
            <div class="card-book-title" title="${note.title}">${note.title}</div>
            <div class="card-book-author" title="${note.author}">by ${note.author}</div>
          </div>
          
          <div class="card-content ${!hasContent ? 'empty' : ''}">
            ${hasContent ? note.content.replace(/\n/g, '<br/>') : '<i>No content saved</i>'}
          </div>
          
          <div class="card-footer">
            <span class="card-date">${note.dateAdded || 'Historical date'}</span>
            <div class="card-actions">
              <button class="card-btn edit" title="Edit note" ${!isApiConnected ? 'disabled' : ''}>✏️</button>
              <button class="card-btn delete" title="Delete note" ${!isApiConnected ? 'disabled' : ''}>🗑️</button>
            </div>
          </div>
        `;

        // Wire buttons
        const editBtn = card.querySelector(".edit");
        const deleteBtn = card.querySelector(".delete");

        if (isApiConnected) {
          editBtn.addEventListener("click", () => {
            noteToEdit = note;
            modalTitleEl.textContent = "Edit Clipping";
            
            formTitle.value = note.title;
            formAuthor.value = note.author;
            formType.value = note.type;
            formPage.value = note.page;
            formLocation.value = note.location;
            formContent.value = note.content;
            
            showModal(true);
          });

          deleteBtn.addEventListener("click", () => {
            noteToDelete = note;
            deletePreviewBook.textContent = `${note.title} (${note.author})`;
            deletePreviewText.textContent = note.content || "Empty Bookmark clipping";
            
            noteModalBackdrop.classList.add("active");
            deleteModal.classList.add("active");
          });
        }

        gridEl.appendChild(card);
      });
    }

    // Search input handler
    searchInput.addEventListener("input", (e) => {
      searchQuery = e.target.value.toLowerCase().trim();
      clearSearchBtn.style.display = searchQuery ? "inline-block" : "none";
      renderGrid();
    });

    clearSearchBtn.addEventListener("click", () => {
      searchInput.value = "";
      searchQuery = "";
      clearSearchBtn.style.display = "none";
      renderGrid();
    });

    // Books sidebar list filter
    booksSearchInput.addEventListener("input", () => {
      renderSidebar();
    });

    // Reset filter buttons inside empty states
    resetFiltersBtn.addEventListener("click", () => {
      selectedBook = "all";
      searchQuery = "";
      searchInput.value = "";
      clearSearchBtn.style.display = "none";
      booksSearchInput.value = "";
      renderSidebar();
      renderGrid();
    });

    // Start connection check
    checkApiConnection();
  });
</script>
