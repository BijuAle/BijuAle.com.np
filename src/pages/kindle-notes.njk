<!-- Inject build-time data -->
<script>
  const RO_NOTES = {{ clippings | dump | safe }} || [];
</script>

<script>
  (function () {
    var notes = RO_NOTES;
    var selBook = "all";
    var searchQ = "";
    var viewMode = "swipe";
    var swipeIndex = 0;

    // Elements
    var grid = document.getElementById("ro-grid");
    var listDesk = document.getElementById("bk-list-desk");
    var dropdownEl = document.getElementById("bk-dropdown");
    var searchEl = document.getElementById("ro-search");
    var clearBtn = document.getElementById("ro-clear");
    var bkSearch = document.getElementById("bk-search-desk");
    var countEl = document.getElementById("ro-count");
    var labelEl = document.getElementById("ro-filter-label");
    var subEl = document.getElementById("ro-filter-sub");
    var btnGrid = document.getElementById("btn-view-grid");
    var btnSwipe = document.getElementById("btn-view-swipe");

    // Try to load fresh notes from the API (dev mode)
    fetch("/api/notes")
      .then(function (r) { if (r.ok) return r.json(); throw new Error(); })
      .then(function (fresh) { notes = fresh; render(); })
      .catch(function () { render(); });

    /* ── Helpers ── */
    function bookMap() {
      var m = {};
      notes.forEach(function (n) {
        if (!m[n.title]) m[n.title] = { author: n.author, count: 0 };
        m[n.title].count++;
      });
      return m;
    }

    function filtered() {
      var out = selBook === "all" ? notes : notes.filter(function (n) { return n.title === selBook; });
      if (searchQ) {
        out = out.filter(function (n) {
          return (n.content && n.content.toLowerCase().includes(searchQ))
            || n.title.toLowerCase().includes(searchQ)
            || (n.author && n.author.toLowerCase().includes(searchQ));
        });
      }
      return out;
    }

    function selectBook(b) {
      selBook = b;
      render();
    }

    /* ── Render sidebar (desktop) ── */
    function renderSidebar() {
      var bq = bkSearch ? bkSearch.value.toLowerCase().trim() : "";
      var bm = bookMap();
      var books = Object.keys(bm).sort(function (a, b) { return a.localeCompare(b); });
      if (bq) books = books.filter(function (b) { return b.toLowerCase().includes(bq) || bm[b].author.toLowerCase().includes(bq); });

      listDesk.innerHTML = "";

      // "All" item
      var all = document.createElement("li");
      all.className = selBook === "all" ? "bk-active" : "";
      all.innerHTML = '<span class="bk-name">All Books</span><span class="bk-cnt">' + notes.length + '</span>';
      all.addEventListener("click", function () { selectBook("all"); });
      listDesk.appendChild(all);

      books.forEach(function (b) {
        var li = document.createElement("li");
        li.className = selBook === b ? "bk-active" : "";
        li.title = b + " — " + bm[b].author;
        li.innerHTML = '<span class="bk-name">' + esc(b) + '</span><span class="bk-cnt">' + bm[b].count + '</span>';
        li.addEventListener("click", function () { selectBook(b); });
        listDesk.appendChild(li);
      });
    }

    /* ── Render dropdown (mobile) ── */
    function renderDropdown() {
      if (!dropdownEl) return;
      var bm = bookMap();
      var books = Object.keys(bm).sort(function (a, b) { return a.localeCompare(b); });

      dropdownEl.innerHTML = "";

      var allOpt = document.createElement("option");
      allOpt.value = "all";
      allOpt.textContent = "All (" + notes.length + ")";
      allOpt.selected = (selBook === "all");
      dropdownEl.appendChild(allOpt);

      books.forEach(function (b) {
        var opt = document.createElement("option");
        opt.value = b;
        opt.textContent = b + " (" + bm[b].count + ")";
        opt.selected = (selBook === b);
        dropdownEl.appendChild(opt);
      });
    }

    function buildCard(note, showBook) {
      var badgeClass = note.type ? note.type.toLowerCase() : "highlight";
      var loc = [];
      if (note.page) loc.push("p." + note.page);
      if (note.location) loc.push("loc " + note.location);
      var locStr = loc.join(" · ") || "snippet";

      var hasContent = note.content && note.content.trim().length > 0;
      var hasNote = note.noteContent && note.noteContent.trim().length > 0;

      var card = document.createElement("div");
      card.className = "ro-card";

      var contentHtml = '<div class="ro-card-content' + (!hasContent ? " empty" : "") + '">' +
        (hasContent ? esc(note.content).replace(/\n/g, "<br>") : "<i>Empty bookmark</i>") +
        '</div>';

      if (hasNote) {
        contentHtml += '<div class="ro-card-note"><div class="ro-note-label">My Note:</div>' + esc(note.noteContent).replace(/\n/g, "<br>") + '</div>';
      }

      card.innerHTML =
        '<div class="ro-card-top">' +
        '<span>🔖 ' + esc(locStr) + '</span>' +
        '<span class="ro-badge ' + badgeClass + '">' + esc(note.type || "Highlight") + '</span>' +
        '</div>' +
        '<div class="ro-card-book' + (showBook ? " visible" : "") + '">' +
        '<div class="ro-book-title" title="' + esc(note.title) + '">' + esc(note.title) + '</div>' +
        '<div class="ro-book-author">by ' + esc(note.author || "Unknown") + '</div>' +
        '</div>' +
        contentHtml +
        '<div class="ro-card-date">' + esc(note.dateAdded || "") + '</div>';

      return card;
    }

    /* ── Render grid ── */
    function renderGrid() {
      var items = filtered();
      var showBook = selBook === "all";

      // Update filter label
      if (selBook === "all") {
        labelEl.childNodes[0].textContent = "All Clippings ";
        subEl.textContent = "";
      } else {
        labelEl.childNodes[0].textContent = selBook + " ";
        var bm = bookMap();
        subEl.textContent = bm[selBook] ? "by " + bm[selBook].author : "";
      }

      countEl.innerHTML = "<strong>" + items.length + "</strong> clipping" + (items.length !== 1 ? "s" : "");
      grid.innerHTML = "";
      grid.className = viewMode === "grid" ? "notes-ro-grid" : "notes-ro-swipe-container";

      if (items.length === 0) {
        grid.className = "notes-ro-grid";
        var empty = document.createElement("div");
        empty.className = "ro-empty";
        empty.innerHTML =
          '<div class="ro-empty-icon">📖</div>' +
          '<h3>No clippings found</h3>' +
          '<p>Try a different search or book.</p>' +
          '<button class="ro-reset" id="ro-reset-btn">Reset filters</button>';
        empty.querySelector("#ro-reset-btn").addEventListener("click", function () {
          selBook = "all"; searchQ = ""; searchEl.value = ""; clearBtn.style.display = "none"; render();
        });
        grid.appendChild(empty);
        return;
      }

      if (viewMode === "grid") {
        items.forEach(function (note) {
          grid.appendChild(buildCard(note, showBook));
        });
      } else {
        // Swipe Mode
        if (swipeIndex < 0) swipeIndex = 0;
        if (swipeIndex >= items.length) swipeIndex = items.length - 1;

        var note = items[swipeIndex];

        var info = document.createElement("div");
        info.className = "notes-swipe-info";
        info.textContent = (swipeIndex + 1) + " of " + items.length;

        var prevBtn = document.createElement("button");
        prevBtn.className = "notes-swipe-btn notes-swipe-prev";
        prevBtn.innerHTML = "◀";
        prevBtn.disabled = swipeIndex === 0;
        prevBtn.onclick = function () { swipeIndex--; renderGrid(); };

        var nextBtn = document.createElement("button");
        nextBtn.className = "notes-swipe-btn notes-swipe-next";
        nextBtn.innerHTML = "▶";
        nextBtn.disabled = swipeIndex === items.length - 1;
        nextBtn.onclick = function () { swipeIndex++; renderGrid(); };

        var wrapper = document.createElement("div");
        wrapper.className = "notes-ro-swipe-card-wrapper";

        wrapper.appendChild(prevBtn);
        wrapper.appendChild(buildCard(note, showBook));
        wrapper.appendChild(nextBtn);

        var topContainer = document.createElement("div");
        topContainer.className = "notes-ro-swipe-container";
        topContainer.appendChild(info);
        topContainer.appendChild(wrapper);
        grid.appendChild(topContainer);

        // Touch swipe logic
        var startX = 0;
        wrapper.addEventListener("touchstart", function (e) {
          startX = e.changedTouches[0].screenX;
        }, { passive: true });
        wrapper.addEventListener("touchend", function (e) {
          var endX = e.changedTouches[0].screenX;
          if (startX - endX > 40 && swipeIndex < items.length - 1) {
            swipeIndex++; renderGrid();
          } else if (endX - startX > 40 && swipeIndex > 0) {
            swipeIndex--; renderGrid();
          }
        }, { passive: true });
      }
    }

    /* ── Full render ── */
    function render() {
      renderSidebar();
      renderDropdown();
      renderGrid();
    }

    /* ── Events ── */
    searchEl.addEventListener("input", function () {
      searchQ = searchEl.value.toLowerCase().trim();
      clearBtn.style.display = searchQ ? "block" : "none";
      renderGrid();
    });

    clearBtn.addEventListener("click", function () {
      searchEl.value = ""; searchQ = ""; clearBtn.style.display = "none"; renderGrid();
    });

    if (bkSearch) {
      bkSearch.addEventListener("input", renderSidebar);
    }

    if (dropdownEl) {
      dropdownEl.addEventListener("change", function (e) {
        selectBook(e.target.value);
      });
    }

    if (btnGrid && btnSwipe) {
      btnGrid.addEventListener("click", function () {
        viewMode = "grid";
        btnGrid.className = "view-btn active";
        btnSwipe.className = "view-btn";
        renderGrid();
      });

      btnSwipe.addEventListener("click", function () {
        viewMode = "swipe";
        btnSwipe.className = "view-btn active";
        btnGrid.className = "view-btn";
        swipeIndex = 0;
        renderGrid();
      });
    }

    /* ── Escape helper ── */
    function esc(s) {
      return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    render();
  })();
</script>